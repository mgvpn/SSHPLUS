#!/bin/bash
#====================================================
#	@kiritosshxd - Con soporte HWID
#====================================================
IP=$(cat /etc/IP)
cor1='\033[41;1;37m'
cor2='\033[44;1;37m'
scor='\033[0m'

# Archivo para almacenar HWIDs
HWID_FILE="/etc/SSHPlus/hwid.db"
mkdir -p /etc/SSHPlus

# Función para generar HWID aleatorio
generate_hwid() {
    echo $(cat /dev/urandom | tr -dc 'a-f0-9' | fold -w 16 | head -n 1)
}

# Función para registrar HWID
register_hwid() {
    local user=$1
    local hwid=$2
    echo "$user:$hwid" >> "$HWID_FILE"
}

# Función para eliminar HWID
remove_hwid() {
    local user=$1
    sed -i "/^$user:/d" "$HWID_FILE"
}

# Función para cambiar HWID
change_hwid() {
    local user=$1
    local new_hwid=$2
    sed -i "s/^$user:.*/$user:$new_hwid/" "$HWID_FILE"
}

# Menú de gestión HWID
fun_hwid_menu() {
    clear
    echo -e "\E[44;1;37m         GESTIÓN DE USUARIOS HWID        \E[0m"
    echo ""
    echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;33mCREAR USUARIO SSH CON HWID"
    echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;33mVERIFICAR HWID DE USUARIO"
    echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;33mLISTAR USUARIOS CON HWID"
    echo -e "\033[1;31m[\033[1;36m4\033[1;31m] \033[1;33mCAMBIAR HWID DE USUARIO"
    echo -e "\033[1;31m[\033[1;36m5\033[1;31m] \033[1;33mELIMINAR HWID DE USUARIO"
    echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;33mSALIR"
    echo ""
    echo -ne "\033[1;32mSELECCIONE UNA OPCIÓN: \033[1;37m"
    read hwid_option
    
    case $hwid_option in
        1) create_hwid_user ;;
        2) verify_hwid_user ;;
        3) list_hwid_users ;;
        4) change_hwid_user ;;
        5) remove_hwid_user ;;
        0) exit 0 ;;
        *) 
            echo -e "\n\033[1;31mOpción inválida!\033[0m"
            sleep 2
            fun_hwid_menu
            ;;
    esac
}

create_hwid_user() {
    [[ ! -e /usr/lib/sshplus ]] && exit 0
    tput setaf 7;tput setab 4;tput bold;printf '%30s%s%-15s\n' "Criar Usuário SSH con HWID";tput sgr0
    echo ""
    echo -ne "\033[1;32mNome do usuário:\033[1;37m ";read username
    [[ -z $username ]] && {
        echo -e "\n${cor1}Nome de usuário vazio ou invalido!${scor}\n"
        exit 1
    }
    [[ "$(grep -wc $username /etc/passwd)" != '0' ]] && {
        echo -e "\n${cor1}Este usuário já existe. tente outro nome!${scor}\n"
        exit 1
    }
    [[ ${username} != ?(+|-)+([a-zA-Z0-9]) ]] && {
        echo -e "\n${cor1}Você digitou um nome de usuário inválido!${scor}"
        echo -e "${cor1}Não use espaços, acentos ou caracteres especiais!${scor}\n"
        exit 1
    }
    sizemin=$(echo ${#username})
    [[ $sizemin -lt 4 ]] && {
        echo -e "\n${cor1}Escribiste un nombre de usuário muito corto${scor}"
        echo -e "${cor1}use un mínimo 4 caracteres!${scor}\n"
        exit 1
    }
    sizemax=$(echo ${#username})
    [[ $sizemax -gt 32 ]] && {
        echo -e "\n${cor1}wep Escribiste un nombre de usuário mui grande"
        echo -e "${cor1}use un máximo 32 caracteres!${scor}\n"
        exit 1
    }
    
    # PEDIR HWID directamente
    echo -ne "\033[1;32mHWID:\033[1;37m ";read hwid
    [[ -z $hwid ]] && {
        echo -e "\n${cor1}HWID vacío!${scor}\n"
        exit 1
    }
    
    echo -ne "\033[1;32mDias para expirar:\033[1;37m ";read dias
    [[ -z $dias ]] && {
        echo -e "\n${cor1}Numero de dias vazio!${scor}\n"
        exit 1
    }
    [[ ${dias} != ?(+|-)+([0-9]) ]] && {
        echo -e "\n${cor1}Você digitou um número de dias inválido!${scor}\n"
        exit 1
    }
    [[ $dias -lt 1 ]] && {
        echo -e "\n${cor1}O número deve ser maior que zero!${scor}\n"
        exit 1
    }
    echo -ne "\033[1;32mLimite de conecion:\033[1;37m ";read sshlimiter
    [[ -z $sshlimiter ]] && {
        echo -e "\n${cor1}Escribiste limite de conecion vazio!${scor}\n"
        exit 1
    }
    [[ ${sshlimiter} != ?(+|-)+([0-9]) ]] && {
        echo -e "\n${cor1}Escribiste un número de conecion inválido!${scor}\n"
        exit 1
    }
    [[ $sshlimiter -lt 1 ]] && {
        echo -e "\n${cor1}Número de conecion simultâneas deve ser maior que zero!${scor}\n"
        exit 1
    }
    
    final=$(date "+%Y-%m-%d" -d "+$dias days")
    gui=$(date "+%d/%m/%Y" -d "+$dias days")
    
    # Crear usuario sin contraseña (solo HWID)
    useradd -e $final -M -s /bin/false $username >/dev/null 2>&1 &
    passwd -d $username >/dev/null 2>&1
    
    echo "$username $sshlimiter" >>/root/usuarios.db
    register_hwid "$username" "$hwid"
    
    clear
    echo -e "\E[44;1;37m       CONTA SSH CON HWID CRIADA !      \E[0m"
    echo -e "\n\033[1;32mIP: \033[1;37m$IP"
    echo -e "\033[1;32mUsuário: \033[1;37m$username"
    echo -e "\033[1;32mHWID: \033[1;33m$hwid"
    echo -e "\033[1;32mExpira em: \033[1;37m$gui"
    echo -e "\033[1;32mLimite de conexões: \033[1;37m$sshlimiter"
    echo -e "\033[1;32mTipo: \033[1;33mHWID (Hardware ID)"
    echo "$hwid" > /etc/SSHPlus/hwid/$username
    echo ""
    echo -e "\033[1;33mNOTA: Este usuario solo podrá conectarse desde"
    echo -e "el dispositivo con el HWID proporcionado.\033[0m"
    echo ""
    echo -ne "\033[1;32mPRESIONE ENTER PARA VOLVER AL MENÚ\033[1;37m"
    read
    fun_hwid_menu
}

verify_hwid_user() {
    clear
    echo -e "\E[44;1;37m         VERIFICAR HWID DE USUARIO        \E[0m"
    echo ""
    echo -ne "\033[1;32mNombre de usuario: \033[1;37m"
    read user
    
    if [[ -f "$HWID_FILE" ]]; then
        hwid_line=$(grep "^$user:" "$HWID_FILE")
        if [[ -n $hwid_line ]]; then
            hwid=$(echo $hwid_line | cut -d: -f2)
            echo -e "\n\033[1;32mUsuario: \033[1;37m$user"
            echo -e "\033[1;32mHWID: \033[1;33m$hwid"
            if [[ -f /root/usuarios.db ]]; then
                limit=$(grep "^$user " /root/usuarios.db | awk '{print $2}')
                echo -e "\033[1;32mLímite: \033[1;37m$limit"
            fi
            if id "$user" &>/dev/null; then
                exp_date=$(chage -l $user | grep "Account expires" | cut -d: -f2)
                echo -e "\033[1;32mExpira: \033[1;37m$exp_date"
            fi
        else
            echo -e "\n\033[1;31mEste usuario no tiene HWID registrado.\033[0m"
        fi
    else
        echo -e "\n\033[1;31mNo hay usuarios HWID registrados.\033[0m"
    fi
    
    echo ""
    echo -ne "\033[1;32mPRESIONE ENTER PARA VOLVER AL MENÚ\033[1;37m"
    read
    fun_hwid_menu
}

list_hwid_users() {
    clear
    echo -e "\E[44;1;37m         LISTA DE USUARIOS CON HWID        \E[0m"
    echo ""
    
    if [[ -f "$HWID_FILE" ]] && [[ -s "$HWID_FILE" ]]; then
        echo -e "\033[1;32mUsuarios registrados:\033[0m"
        echo ""
        printf "%-15s %-20s %-10s %-10s\n" "USUARIO" "HWID" "LÍMITE" "ESTADO"
        echo "────────────────────────────────────────────────────────────────"
        
        while IFS=: read -r user hwid; do
            if id "$user" &>/dev/null; then
                estado="\033[1;32mActivo\033[0m"
                limit=$(grep "^$user " /root/usuarios.db 2>/dev/null | awk '{print $2}')
                [[ -z $limit ]] && limit="N/A"
            else
                estado="\033[1;31mExpirado\033[0m"
                limit="N/A"
            fi
            printf "%-15s %-20s %-10s %b\n" "$user" "$hwid" "$limit" "$estado"
        done < "$HWID_FILE"
    else
        echo -e "\033[1;31mNo hay usuarios HWID registrados.\033[0m"
    fi
    
    echo ""
    echo -ne "\033[1;32mPRESIONE ENTER PARA VOLVER AL MENÚ\033[1;37m"
    read
    fun_hwid_menu
}

change_hwid_user() {
    clear
    echo -e "\E[44;1;37m         CAMBIAR HWID DE USUARIO        \E[0m"
    echo ""
    echo -ne "\033[1;32mNombre de usuario: \033[1;37m"
    read user
    
    if [[ -f "$HWID_FILE" ]]; then
        if grep -q "^$user:" "$HWID_FILE"; then
            old_hwid=$(grep "^$user:" "$HWID_FILE" | cut -d: -f2)
            echo -e "\033[1;33mHWID actual: \033[1;37m$old_hwid"
            echo ""
            echo -ne "\033[1;32mIngrese nuevo HWID:\033[1;37m ";read new_hwid
            [[ -z $new_hwid ]] && {
                echo -e "\n${cor1}HWID vacío!${scor}\n"
                exit 1
            }
            
            change_hwid "$user" "$new_hwid"
            echo "$new_hwid" > /etc/SSHPlus/hwid/$user
            echo -e "\n\033[1;32m✓ HWID cambiado correctamente para $user\033[0m"
        else
            echo -e "\n\033[1;31mEste usuario no tiene HWID registrado.\033[0m"
        fi
    else
        echo -e "\n\033[1;31mNo hay usuarios HWID registrados.\033[0m"
    fi
    
    echo ""
    echo -ne "\033[1;32mPRESIONE ENTER PARA VOLVER AL MENÚ\033[1;37m"
    read
    fun_hwid_menu
}

remove_hwid_user() {
    clear
    echo -e "\E[44;1;37m         ELIMINAR HWID DE USUARIO        \E[0m"
    echo ""
    echo -ne "\033[1;32mNombre de usuario: \033[1;37m"
    read user
    
    if [[ -f "$HWID_FILE" ]]; then
        if grep -q "^$user:" "$HWID_FILE"; then
            remove_hwid "$user"
            rm -f /etc/SSHPlus/hwid/$user
            echo -e "\n\033[1;32m✓ HWID eliminado correctamente para $user\033[0m"
        else
            echo -e "\n\033[1;31mEste usuario no tiene HWID registrado.\033[0m"
        fi
    else
        echo -e "\n\033[1;31mNo hay usuarios HWID registrados.\033[0m"
    fi
    
    echo ""
    echo -ne "\033[1;32mPRESIONE ENTER PARA VOLVER AL MENÚ\033[1;37m"
    read
    fun_hwid_menu
}

# Iniciar el menú HWID
fun_hwid_menu