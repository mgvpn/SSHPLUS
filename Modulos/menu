function autoexec () {
   if grep "menu;" /etc/profile > /dev/null; then
      clear
      echo -e "${verde}DESACTIVANDO AUTO INICIO\e[0m"
      offautmenu () {
         sed -i '/menu;/d' /etc/profile
      }
      echo ""
      fun_bar 'offautmenu'
      echo ""
      echo -e "${rojo}AUTO INICIO DESACTIVADO!\e[0m"
      sleep 1.5s
      menu2
   else
      clear
      echo -e "${verde}ACTIVANDO AUTO INICIO\e[0m"
      autmenu () {
         grep -v "^menu;" /etc/profile > /tmp/tmpass && mv /tmp/tmpass /etc/profile
         echo "menu;" >> /etc/profile
      }
      echo ""
      fun_bar 'autmenu'
      echo ""
      echo -e "${verde}AUTO INICIO ACTIVADO!\e[0m"
      sleep 1.5s
      menu2
   fi
}
