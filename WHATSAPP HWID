function normalizeHWID(hwid) {
    return hwid.trim().toUpperCase().replace(/[^A-Z0-9\-]/g, '');
}

function validateHWID(hwid) {
    const normalized = normalizeHWID(hwid);
    return normalized.length >= 10 && normalized.length <= 64;
}

