    const hwidShort = hwid.substring(0, 8).toLowerCase().replace(/[^a-z0-9]/g, '');
    return `ssh${hwidShort}${Math.floor(100 + Math.random() * 900)}`;
}

async function createSSHUser(phone, hwid, personName, days = 0) {
    const username = generateSSHUsername(hwid);
    
